{
    "name": "@vincenzosgueradev/pptb-connection-reference-governance",
    "version": "0.1.0",
    "displayName": "Connection Reference Governance",
    "description": "See which connection references every flow in a solution uses, find references with no connection or flows pointing at a missing reference, and change or re-point them in bulk after a preview. Works on unmanaged solutions in the connected environment.",
    "type": "module",
    "main": "index.html",
    "icon": "logo.svg",
    "author": "Vincenzo Sguera",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "test": "vitest run",
        "test:full": "cross-env TEST_FULL=1 vitest run",
        "test:watch": "vitest",
        "validate": "pptb-validate",
        "test:mutation": "node scripts/mutation-check.mjs"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.0",
        "@types/node": "^26.6.5",
        "cross-env": "^10.1.0",
        "jsdom": "^30.1.3",
        "tsx": "^4.19.2",
        "typescript": "^5.0.0",
        "vite": "^8.0.3",
        "vitest": "^5.0.5"
    },
    "files": [
        "dist"
    ],
    "contributors": [
        {
            "name": "Vincenzo Sguera",
            "url": "https://github.com/vincenzosgueradev"
        }
    ],
    "keywords": [
        "pptb",
        "power-platform"
    ],
    "configurations": {
        "repository": "https://github.com/vincenzosgueradev/connection-reference-governance",
        "readmeUrl": "https://raw.githubusercontent.com/vincenzosgueradev/connection-reference-governance/main/README.md",
        "website": "https://github.com/vincenzosgueradev/connection-reference-governance",
        "category": "Development"
    },
    "features": {
        "connections": 1,
        "minAPI": "1.2.7"
    }
}
